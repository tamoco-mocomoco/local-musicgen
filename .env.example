# ACE-Step 1.5 のチェックアウト (その中の .venv と checkpoints/ を使う)。必須
ACESTEP_HOME=/path/to/ACE-Step-1.5

# 待ち受け (既定は自分のマシンからだけ)
#HOST=127.0.0.1
#PORT=8100

# 使われなければモデルを自動で解放するまでの秒数 (0 で解放しない)
#IDLE_UNLOAD_SECONDS=300

# 省メモリ設定 (1 = 既定。0 にすると ACE-Step 標準の設定)
#MUSIC_LEAN=1
# 言語モデル (acestep-5Hz-lm-0.6B / acestep-5Hz-lm-1.7B / none)
#MUSIC_LM=acestep-5Hz-lm-0.6B
